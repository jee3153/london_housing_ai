FROM python:3.12-slim

# Install system dependencies for psycopg2, etc.
RUN apt-get update && apt-get install -y build-essential libpq-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml backend/poetry.lock ./

# Install Poetry and configure it to install system-wide
RUN pip install poetry \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-root

COPY backend/ .

ENV PYTHONPATH=/app/src

EXPOSE 10000

# Render injects $PORT at runtime (defaults to 10000) and expects the process
# to bind to it — unlike Railway, it does not auto-detect a hardcoded port.
# Shell-form CMD is required so the env var actually expands.
CMD uvicorn london_housing_ai.api.main_api:app --host 0.0.0.0 --port ${PORT:-10000}
